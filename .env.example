# Copy to .env for local overrides. Development defaults only — never use in production.
DD_PG_USER=dhandrishti
DD_PG_PASSWORD=dhandrishti_dev
DD_PG_DB=dhandrishti
DD_PG_PORT=5432
DD_REDIS_PORT=6379
DD_DATABASE_URL=postgresql://dhandrishti:dhandrishti_dev@localhost:5432/dhandrishti
DD_REDIS_URL=redis://localhost:6379/0
# API
DD_API_PORT=4000
DD_REDIS_URL=redis://127.0.0.1:6379/0   # "off" disables the cache (rate-limit counters then live in-process)
DD_RATE_LIMIT_MAX=300                    # requests per window per client IP
DD_RATE_LIMIT_WINDOW_MS=60000
DD_WEB_ORIGIN=https://dhandrishti.test,http://dhandrishti.test:3100,http://localhost:3100,http://127.0.0.1:3100
# AI research assistant (Claude). Leave unset to keep the assistant disabled.
# ANTHROPIC_API_KEY=
DD_AI=auto                               # auto | on | off
DD_AI_RATE_LIMIT_MAX=10                  # AI requests per minute per client IP
# Read-only live quotes (Kite ticker) for a small watchlist; uses the session from `pnpm kite:login`.
# DD_LIVE_WATCHLIST=RELIANCE,TCS,HDFCBANK  # NSE symbols; unset = live feed off (end-of-day prices only)
# DD_LIVE=off                              # force the live feed off even with a watchlist
# DD_LIVE_FRESH_SECONDS=60                 # a live price older than this is shown as "no recent trade"
# DD_LIVE_MAX_SYMBOLS=50                   # cap on subscribed instruments
# DD_KITE_SESSION_FILE=~/.config/dhandrishti/kite_session.json
# Web
DD_API_URL=http://127.0.0.1:4000         # server-side calls from Next.js to the API
# NEXT_PUBLIC_DD_API_URL=                # browser override; default = page host + NEXT_PUBLIC_DD_API_PORT
NEXT_PUBLIC_DD_API_PORT=4000
DD_DEV_HOSTS=dhandrishti.test,dhandrishti.localhost   # hostnames allowed by the Next.js dev server
DD_TRUST_PROXY=loopback                  # trust X-Forwarded-For from a local proxy (Caddy); "false" to disable
# Caddy (pnpm proxy)
DD_DOMAIN=dhandrishti.test
DD_HTTPS_PORT=443
